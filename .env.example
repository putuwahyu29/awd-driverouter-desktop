# Awd DriveRouter Environment Configuration Example

# Server Mode: set to 'true' to run as a Headless Web Server without Desktop GUI
SERVER_MODE=true

# Server Host and Port
HOST=0.0.0.0
PORT=8080

# Security API Key / Password (Leave empty for open local access, or set strong secret for public VPS/Docker)
API_KEY=YourSecretPassword123!
